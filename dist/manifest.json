{
  "id": "/",
  "name": "POWERSTAR — City Services",
  "short_name": "POWERSTAR",
  "description": "Book verified manpower and transport services across Karnataka",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#f97316",
  "lang": "en-IN",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["utilities", "lifestyle", "business"],
  "iarc_rating_id": "",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Book a Service",
      "short_name": "Book",
      "description": "Book a new service",
      "url": "/dashboard/book",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Track Booking",
      "short_name": "Track",
      "description": "Track your active booking",
      "url": "/dashboard/track",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Provider Dashboard",
      "short_name": "Provide",
      "description": "Open provider dashboard",
      "url": "/provider",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+powerstar",
      "url": "/?action=%s"
    }
  ],
  "share_target": {
    "action": "/dashboard/book",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}
